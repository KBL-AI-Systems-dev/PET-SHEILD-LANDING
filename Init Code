  <!-- VANILLA JAVASCRIPT: SIMULATOR, MODALS, CLIPBOARD & WEBHOOK HOOKS      -->
  <!-- ===================================================================== -->
  <script>
    // Optional free-tier webhook URL (e.g., Make, Zapier, n8n, or Formspree endpoint)
    const WEBHOOK_URL = "";

    let currentSimSpecies = "Dog";
    let currentSimSymptom = "vomiting";

    const simScenarios = {
      vomiting: {
        badge: "Urgent Review Recommended",
        badgeClass: "bg-amber-500/20 text-amber-300 border-amber-400/50",
        Dog: "Dog • Repeated Vomiting: High dehydration risk if unable to hold water. Check gum moisture and abdominal tension. Generates Priority Case Packet for optional $49/$79 clinic review or local urgent care.",
        Cat: "Cat • Repeated Vomiting: Multiple episodes in a few hours warrant prompt evaluation for foreign body or pancreatitis. Generates Priority Case Packet ready for clinic handoff."
      },
      lethargy: {
        badge: "Same-Day / Urgent Check",
        badgeClass: "bg-amber-500/20 text-amber-300 border-amber-400/50",
        Dog: "Dog • Sudden Lethargy: Track appetite, water intake, and gum color. Creates structured baseline Case Packet to monitor progression or request a $49/$79 partner consult.",
        Cat: "Cat • Sudden Hiding/Lethargy: Cats mask pain until illness is advanced. Verify litter box output immediately; prepares Priority Case Packet for veterinary review."
      },
      toxin: {
        badge: "Immediate ER Attention",
        badgeClass: "bg-rose-500/20 text-rose-300 border-rose-400/50",
        Dog: "Dog • Possible Toxin Exposure: Time-critical window. Log exact substance, estimated amount, and pet weight in your Emergency Case Packet before heading to ER.",
        Cat: "Cat • Possible Toxin/Plant Exposure: Lilies, human meds, and essential oils are rapidly toxic to cats. Generates Immediate ER Case Packet for front-desk handoff."
      },
      limping: {
        badge: "Monitor / Routine Vet",
        badgeClass: "bg-emerald-500/20 text-emerald-300 border-emerald-400/50",
        Dog: "Dog • Mild Limping/Minor Scrape: If weight-bearing with no active bleeding or swelling, restrict activity and log a baseline Case Packet for your regular vet.",
        Cat: "Cat • Mild Limping: Restrict jumping for 12–24 hours and check paw pads. Saves symptom timestamp in your Case Packet in case swelling develops."
      }
    };

    function setSimSpecies(species) {
      currentSimSpecies = species;
      const dogBtn = document.getElementById("simSpeciesDog");
      const catBtn = document.getElementById("simSpeciesCat");

      if (species === "Dog") {
        dogBtn.className = "sim-species-btn py-2.5 px-3 rounded-xl border border-cyan-400 bg-cyan-500/15 text-white font-semibold text-sm flex items-center justify-center gap-2 cursor-pointer transition";
        catBtn.className = "sim-species-btn py-2.5 px-3 rounded-xl border border-slateborder bg-navy text-slate-300 hover:border-slate-500 font-semibold text-sm flex items-center justify-center gap-2 cursor-pointer transition";
      } else {
        catBtn.className = "sim-species-btn py-2.5 px-3 rounded-xl border border-cyan-400 bg-cyan-500/15 text-white font-semibold text-sm flex items-center justify-center gap-2 cursor-pointer transition";
        dogBtn.className = "sim-species-btn py-2.5 px-3 rounded-xl border border-slateborder bg-navy text-slate-300 hover:border-slate-500 font-semibold text-sm flex items-center justify-center gap-2 cursor-pointer transition";
      }
      renderSimOutput();
    }

    function selectSimSymptom(symptomKey) {
      currentSimSymptom = symptomKey;
      document.querySelectorAll(".sim-symptom-btn").forEach((btn) => {
        if (btn.dataset.symptom === symptomKey) {
          btn.className = "sim-symptom-btn text-left p-3 rounded-xl border border-cyan-400 bg-cyan-500/10 text-white text-xs font-semibold transition cursor-pointer";
        } else {
          btn.className = "sim-symptom-btn text-left p-3 rounded-xl border border-slateborder bg-navy text-slate-300 hover:border-slate-500 text-xs font-semibold transition cursor-pointer";
        }
      });
      renderSimOutput();
    }

    function renderSimOutput() {
      const scenario = simScenarios[currentSimSymptom];
      const badgeEl = document.getElementById("simUrgencyBadge");
      const textEl = document.getElementById("simGuidanceText");
      badgeEl.textContent = scenario.badge;
      badgeEl.className = `px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wide border ${scenario.badgeClass}`;
      textEl.textContent = scenario[currentSimSpecies];
    }

    // Audience View Switcher (B2C Pet Owner vs. B2B Veterinary Partner)
    let activeAudience = "b2c";
    function switchView(target) {
      activeAudience = target;
      const b2c = document.getElementById("b2cView");
      const b2b = document.getElementById("b2bView");
      const navLinks = document.getElementById("b2cNavLinks");
      const toggleBtn = document.getElementById("viewToggleBtn");

      if (target === "b2b") {
        b2c.classList.add("hidden");
        b2b.classList.remove("hidden");
        navLinks.classList.add("invisible");
        toggleBtn.textContent = "For Pet Owners";
        window.scrollTo({ top: 0, behavior: "smooth" });
      } else {
        b2b.classList.add("hidden");
        b2c.classList.remove("hidden");
        navLinks.classList.remove("invisible");
        toggleBtn.textContent = "For Veterinary Clinics";
      }
    }

    function toggleAudienceView() {
      switchView(activeAudience === "b2c" ? "b2b" : "b2c");
    }

    // FAQ Accordion
    function toggleFaq(buttonEl) {
      const body = buttonEl.nextElementSibling;
      const icon = buttonEl.querySelector(".faq-icon");
      const isHidden = body.classList.contains("hidden");
      body.classList.toggle("hidden");
      icon.textContent = isHidden ? "−" : "+";
    }

    // Modals
    function openTriageModal() {
      document.getElementById("triageFormStep").classList.remove("hidden");
      document.getElementById("triageResultStep").classList.add("hidden");
      document.getElementById("triageModal").classList.remove("hidden");
    }

    function openTriageModalWithSim() {
      openTriageModal();
      document.getElementById("triagePetMeta").value = `${currentSimSpecies} • Approx. Weight`;
      const map = {
        vomiting: "Repeated Vomiting / Diarrhea",
        lethargy: "Sudden Lethargy / Hiding / Refusing Food",
        toxin: "Possible Toxin / Unknown Food Ingestion",
        limping: "Limping / Minor Wound / Eye Squinting"
      };
      document.getElementById("triageConcern").value = map[currentSimSymptom] || "Pre-Crisis Setup (Save Profile Now)";
    }

    function closeTriageModal() {
      document.getElementById("triageModal").classList.add("hidden");
    }

    function openChecklistModal() {
      document.getElementById("checklistFormStep").classList.remove("hidden");
      document.getElementById("checklistResultStep").classList.add("hidden");
      document.getElementById("checklistModal").classList.remove("hidden");
    }

    function closeChecklistModal() {
      document.getElementById("checklistModal").classList.add("hidden");
    }

    function switchChecklistToTriage() {
      closeChecklistModal();
      openTriageModal();
    }

    // Form Handlers with Non-Blocking Webhook Support
    async function dispatchWebhook(payload) {
      if (!WEBHOOK_URL) return;
      try {
        await fetch(WEBHOOK_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
      } catch (e) {
        // Graceful static-mode fallback
      }
    }

    async function handleTriageSubmit(e) {
      e.preventDefault();
      const petName = document.getElementById("triagePetName").value.trim();
      const petMeta = document.getElementById("triagePetMeta").value.trim();
      const concern = document.getElementById("triageConcern").value;
      const email = document.getElementById("triageOwnerEmail").value.trim();
      const packetId = "PSD-" + Math.floor(100000 + Math.random() * 900000);
      const timestamp = new Date().toLocaleString();

      await dispatchWebhook({
        event: "digital_triage_pass_intent",
        packetId,
        petName,
        petMeta,
        concern,
        email,
        timestamp
      });

      const summary = [
        `PETSHIELD DISPATCH™ • EMERGENCY CASE PACKET`,
        `Packet ID: #${packetId} | Generated: ${timestamp}`,
        `Patient: ${petName} (${petMeta})`,
        `Primary Intake Concern: ${concern}`,
        `Owner Contact: ${email}`,
        `Status: Digital Triage Pass ($1.99/mo) Queued • Ready for Partner Clinic Consult ($49/$79) or Direct ER Desk Handoff`
      ].join("\n");

      document.getElementById("generatedPacketOutput").textContent = summary;
      document.getElementById("triageFormStep").classList.add("hidden");
      document.getElementById("triageResultStep").classList.remove("hidden");
    }

    async function handleChecklistSubmit(e) {
      e.preventDefault();
      const email = document.getElementById("checklistEmail").value.trim();
      const species = document.querySelector('input[name="checklistSpecies"]:checked').value;

      await dispatchWebhook({
        event: "free_readiness_checklist_optin",
        species,
        email,
        timestamp: new Date().toISOString()
      });

      document.getElementById("checklistFormStep").classList.add("hidden");
      document.getElementById("checklistResultStep").classList.remove("hidden");
    }

    async function handlePartnerSubmit(e) {
      e.preventDefault();
      const clinicName = document.getElementById("partnerClinicName").value.trim();
      const contactName = document.getElementById("partnerContactName").value.trim();
      const email = document.getElementById("partnerEmail").value.trim();
      const location = document.getElementById("partnerLocation").value.trim();

      await dispatchWebhook({
        event: "b2b_veterinary_partner_inquiry",
        clinicName,
        contactName,
        email,
        location,
        timestamp: new Date().toISOString()
      });

      document.getElementById("partnerLeadForm").classList.add("hidden");
